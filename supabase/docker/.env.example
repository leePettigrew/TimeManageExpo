############################################################################
# TimeTable self-hosted Supabase — environment template
#
# 1. cp .env.example .env
# 2. Generate secrets:  node generate-keys.mjs   (or run it via a node
#    container — see README-unraid.md) and paste the output below.
# 3. Fill in the URL section for your domain.
#
# !!! YOU MUST CHANGE EVERY VALUE MARKED "CHANGE-ME" BEFORE FIRST BOOT !!!
# Several of them (POSTGRES_PASSWORD, JWT_SECRET) are baked into the
# database on first initialisation — changing them later means resetting
# ${DATA_DIR}/db/data or manual surgery.
############################################################################


############
# Unraid paths — every service's persistent state lives under DATA_DIR
# (bind mounts; subfolders are created automatically by Docker):
#   ${DATA_DIR}/db/data                Postgres data
#   ${DATA_DIR}/db/config              pgsodium/vault key material
#   ${DATA_DIR}/studio/snippets        Studio SQL snippets
#   ${DATA_DIR}/studio/edge-functions  (empty; Studio expects the folder)
# NOTE: DATA_DIR is specific to this trimmed stack (the official compose
# uses ./volumes/... relative paths and a named volume instead).
############
DATA_DIR=/mnt/user/appdata/timetable


############
# Secrets — generate real values with:  node generate-keys.mjs
############

# CHANGE-ME — Postgres superuser password (also used for the internal
# supabase_auth_admin / authenticator roles; set on first boot).
POSTGRES_PASSWORD=CHANGE-ME-long-random-postgres-password

# CHANGE-ME — HS256 signing secret for ALL JWTs. Minimum 32 characters.
JWT_SECRET=CHANGE-ME-super-secret-jwt-secret-at-least-32-chars

# CHANGE-ME — API keys minted FROM the JWT_SECRET above (generate-keys.mjs
# prints matching values; they are HS256 JWTs with role=anon/service_role).
# ANON_KEY is safe to embed in the mobile app and dashboard.
# SERVICE_ROLE_KEY bypasses RLS — server/operator use ONLY, never in clients.
ANON_KEY=CHANGE-ME-run-generate-keys
SERVICE_ROLE_KEY=CHANGE-ME-run-generate-keys

# Studio login (Kong HTTP basic auth in front of the dashboard).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE-ME-strong-dashboard-password

# Realtime encryption/signing (from generate-keys.mjs):
# SECRET_KEY_BASE: at least 64 characters.
SECRET_KEY_BASE=CHANGE-ME-at-least-64-characters-long-random-string-goes-here!!
# REALTIME_DB_ENC_KEY: EXACTLY 16 characters.
REALTIME_DB_ENC_KEY=CHANGE-ME-16char
# Studio <-> postgres-meta connection-string encryption: at least 32 chars.
PG_META_CRYPTO_KEY=CHANGE-ME-at-least-32-characters!!

# Optional new-style keys (asymmetric/opaque). Leave empty to run on the
# legacy HS256 keys above — that is fully supported. See:
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# URLs — set these to your real (Cloudflare Tunnel) hostnames.
# The mobile app + web dashboard talk to the API hostname; you open the
# Studio hostname in a browser. BOTH point at Kong (port KONG_HTTP_PORT).
############

# Public URL of Studio/the whole gateway (Studio hostname).
SUPABASE_PUBLIC_URL=http://192.168.1.100:8000

# Full external URL of the Auth service AS CLIENTS SEE IT — keep the
# /auth/v1 suffix (GoTrue sits behind Kong at that path). Also used as the
# JWT issuer. Example prod value: https://api.timetable.example.ie/auth/v1
API_EXTERNAL_URL=http://192.168.1.100:8000/auth/v1

# "Site URL" — where the web dashboard is served from. With email auth
# disabled and phone OTP only, this is mostly informational, but GoTrue
# requires it.
SITE_URL=http://192.168.1.100:3000
# Extra allowed redirect URLs (comma-separated). Fine to leave empty.
ADDITIONAL_REDIRECT_URLS=


############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
# NOTE: if you change POSTGRES_DB away from "postgres", pg_cron will refuse
# to be created there (cron.database_name defaults to "postgres") and the
# scheduled retention jobs in 0006_retention_cron.sql will not run.
POSTGRES_PORT=5432


############
# Auth — phone OTP sign-in (the apps' only auth method)
############

# Access-token lifetime in seconds. supabase-js refreshes automatically;
# session length is governed by refresh tokens, which never expire in this
# configuration — workers stay signed in for months.
JWT_EXPIRY=3600

# Must stay false: a worker's first OTP sign-in creates their auth.users
# row. Real access is gated by the invites table + claim_invite() RPC.
DISABLE_SIGNUP=false

# Email + anonymous sign-in are OFF for this deployment.
ENABLE_EMAIL_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false

# Phone sign-in ON; SMS autoconfirm ON (OTP verification IS the check).
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

# OTP settings
SMS_OTP_EXP=300
SMS_OTP_LENGTH=6
SMS_MAX_FREQUENCY=60s

## ---- DEVELOPMENT: test OTPs, no SMS account needed -------------------
# Map of phone -> fixed code. Phone numbers WITHOUT the leading "+"
# (GoTrue strips "+" and spaces before the lookup; +353 87 000 0000 must be
# written 353870000000). Multiple pairs: "353870000000:123456,3538711111:654321"
# Sign in from the app with +353870000000 and enter code 123456.
# REMOVE THIS LINE'S VALUE IN PRODUCTION.
SMS_TEST_OTP=353870000000:123456
# Optional hard expiry for the test codes (ISO 8601 UTC), e.g.:
# SMS_TEST_OTP_VALID_UNTIL=2027-01-01T00:00:00Z
SMS_TEST_OTP_VALID_UNTIL=

## ---- PRODUCTION: Twilio Verify ----------------------------------------
# 1. Create a Twilio account + Verify service (twilio.com -> Verify).
# 2. Fill these in and set SMS_PROVIDER=twilio_verify.
# 3. Uncomment the three GOTRUE_SMS_TWILIO_VERIFY_* lines in
#    docker-compose.yml (auth service).
# 4. Blank out SMS_TEST_OTP above, then: docker compose up -d auth
SMS_PROVIDER=
# SMS_PROVIDER=twilio_verify
# SMS_TWILIO_VERIFY_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_TWILIO_VERIFY_AUTH_TOKEN=your-twilio-auth-token
# SMS_TWILIO_VERIFY_MESSAGE_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=TimeTable
STUDIO_DEFAULT_PROJECT=TimeTable
# Optional: enables the Studio AI assistant.
OPENAI_API_KEY=


############
# API — PostgREST
############
# Postgres schemas exposed via the REST API. public is where the app lives;
# graphql_public is created by the supabase/postgres image (leave both).
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# API gateway — Kong (the ONLY published entry point of the stack)
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
