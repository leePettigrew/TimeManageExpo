# Copy to dashboard/.env
# Kong gateway URL of your Supabase stack (Cloudflare Tunnel hostname in
# production, http://<unraid-ip>:8000 on the LAN in development).
VITE_SUPABASE_URL=http://192.168.1.100:8000
VITE_SUPABASE_ANON_KEY=paste-anon-key-from-supabase/docker/.env
# Map style — OpenFreeMap is free with no key. Swap one line to move to
# MapTiler or self-hosted Protomaps if it ever degrades.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Billing service URL (the Cloudflare Tunnel hostname pointed at the billing
# container, e.g. https://billing.zovxonline.com). Leave blank to hide billing.
VITE_BILLING_URL=
