# Copy to app/.env — values are inlined into the JS bundle at build time.
# Point at your Supabase stack: the Kong gateway URL (Cloudflare Tunnel
# hostname in production, http://<unraid-ip>:8000 on the LAN in development).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.100:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-from-supabase/docker/.env
